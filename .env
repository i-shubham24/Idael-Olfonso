# Public address of the site, used in index.html for link previews and search
# engines. PLACEHOLDER: set to the real domain once the client has chosen it.
VITE_SITE_URL=https://www.idaelalfonso.ch

# Booking backend (see src/lib/booking.js). Leave empty to keep demo mode.
VITE_BOOKING_API=

# Where the updates pop-up sends { email, lang } (for example a Brevo or Mailchimp endpoint). Empty: prototype only.
VITE_NEWSLETTER_API=
